rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (matches auth.uid)
    // Fields: uid, email, displayName, mobile, photoUrl, pushToken, preferences, createdAt, updatedAt
    // Subcollection: contacts/{contactUid}
    //
    // Collection: groups
    // Document ID: groupId
    // Fields: groupId, name, createdBy, memberIds (list of UIDs), adminIds (list of UIDs), etc.
    // Subcollection: expenses/{expenseId}
    //
    // Collection: groupInvitations
    // Document ID: invitationId
    // Fields: invitationId, groupId, fromUserId, toUserId, toMobile, status, createdAt
    //
    // Collection: expenses
    // Document ID: expenseId
    // Fields: expenseId, groupId, title, amount, paidBy, createdBy, splitDetails, splitType, category, createdAt
    // Subcollection: comments/{commentId}
    // Fields: commentId, expenseId, uid (or userId), userName, text, createdAt
    //
    // Collection: settlements
    // Document ID: settlementId
    // Fields: settlementId, groupId, fromUserId, toUserId, amount, status, billingMonth, createdAt
    //
    // Collection: activities
    // Document ID: activityId
    // Fields: activityId, groupId, type, title, actorUid, amount, createdAt
    //
    // Collection: notifications
    // Document ID: notificationId
    // Fields: notificationId, userId (or recipientUid), senderUid, type, title, message, data, isRead, createdAt
    //
    // Collection: recurringExpenses
    // Document ID: id
    // Fields: recurringExpenseId, groupId, title, amount, paidBy, createdBy, frequency, nextRun, active, createdAt
    //
    // ===============================================================

    // =========================================================
    // 🛡️ HELPER FUNCTIONS
    // =========================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function groupExists(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId));
    }

    function getGroupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function isGroupMember(groupId) {
      return isSignedIn() && 
        groupExists(groupId) && 
        (('memberIds' in getGroupData(groupId)) && request.auth.uid in getGroupData(groupId).memberIds);
    }

    function isGroupAdmin(groupId) {
      return isSignedIn() && 
        groupExists(groupId) && 
        (
          (('createdBy' in getGroupData(groupId)) && getGroupData(groupId).createdBy == request.auth.uid) ||
          (('adminIds' in getGroupData(groupId)) && request.auth.uid in getGroupData(groupId).adminIds)
        );
    }

    function expenseExists(expenseId) {
      return exists(/databases/$(database)/documents/expenses/$(expenseId));
    }

    function getExpenseData(expenseId) {
      return get(/databases/$(database)/documents/expenses/$(expenseId)).data;
    }

    function isExpenseGroupMember(expenseId) {
      return expenseExists(expenseId) && 
        ('groupId' in getExpenseData(expenseId)) && 
        isGroupMember(getExpenseData(expenseId).groupId);
    }

    function isExpenseGroupAdmin(expenseId) {
      return expenseExists(expenseId) && 
        ('groupId' in getExpenseData(expenseId)) && 
        isGroupAdmin(getExpenseData(expenseId).groupId);
    }

    // Supports both 'uid' and 'userId' fields for compatibility with client schemas
    function isCommentAuthor(data) {
      return isSignedIn() && (
        (('uid' in data) && data.uid == request.auth.uid) ||
        (('userId' in data) && data.userId == request.auth.uid)
      );
    }

    // =========================================================
    // 👤 USERS & USER CONTACTS
    // =========================================================
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isUser(userId);

      match /contacts/{contactUid} {
        allow read, write: if isUser(userId);
      }
    }

    // =========================================================
    // 👥 GROUPS (Privilege Escalation Protection)
    // =========================================================
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
        (('createdBy' in request.resource.data) && request.resource.data.createdBy == request.auth.uid) &&
        (('memberIds' in request.resource.data) && request.auth.uid in request.resource.data.memberIds);
      
      // Group Admins (createdBy or adminIds) can update anything.
      // Group Members can update metadata, or remove members / leave group.
      // Invited users can accept invitations by adding themselves to memberIds.
      allow update: if isSignedIn() && (
        isGroupAdmin(groupId) ||
        (isGroupMember(groupId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminIds', 'memberIds'])) ||
        (isGroupMember(groupId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminIds']) && !(request.auth.uid in request.resource.data.memberIds)) ||
        (
          ('memberIds' in request.resource.data) &&
          request.auth.uid in request.resource.data.memberIds &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminIds']) &&
          request.resource.data.memberIds.hasAll(resource.data.memberIds)
        )
      );

      allow delete: if isGroupAdmin(groupId);

      match /expenses/{expenseId} {
        allow read, create, update, delete: if isGroupMember(groupId);

        match /comments/{commentId} {
          allow read: if isGroupMember(groupId);
          allow create: if isGroupMember(groupId) && isCommentAuthor(request.resource.data);
          allow update: if isGroupMember(groupId) && isCommentAuthor(resource.data) && isCommentAuthor(request.resource.data);
          allow delete: if isGroupMember(groupId) && (isCommentAuthor(resource.data) || isGroupAdmin(groupId));
        }
      }
    }

    // =========================================================
    // 📩 GROUP INVITATIONS
    // =========================================================
    match /groupInvitations/{invitationId} {
      allow read: if isSignedIn() && (
        resource == null ||
        (('toUserId' in resource.data) && resource.data.toUserId == request.auth.uid) || 
        (('fromUserId' in resource.data) && resource.data.fromUserId == request.auth.uid) ||
        (('toMobile' in resource.data) && resource.data.toMobile != null && request.auth.token.phone_number == resource.data.toMobile) ||
        (('groupId' in resource.data) && isGroupMember(resource.data.groupId))
      );
      allow create: if isSignedIn() && 
        (('fromUserId' in request.resource.data) && request.resource.data.fromUserId == request.auth.uid) &&
        (('groupId' in request.resource.data) && isGroupMember(request.resource.data.groupId));
      allow update, delete: if isSignedIn() && (
        resource == null ||
        (('toUserId' in resource.data) && resource.data.toUserId == request.auth.uid) || 
        (('fromUserId' in resource.data) && resource.data.fromUserId == request.auth.uid) ||
        (('groupId' in resource.data) && isGroupMember(resource.data.groupId))
      );
    }

    // =========================================================
    // 💸 EXPENSES & COMMENTS
    // =========================================================
    match /expenses/{expenseId} {
      allow read: if isSignedIn() && (
        resource == null || 
        (('groupId' in resource.data) && isGroupMember(resource.data.groupId))
      );
      allow create: if ('groupId' in request.resource.data) && 
        isGroupMember(request.resource.data.groupId) && (
          (('createdBy' in request.resource.data) && request.resource.data.createdBy == request.auth.uid) ||
          (('createdBy' in request.resource.data) && request.resource.data.createdBy in getGroupData(request.resource.data.groupId).memberIds)
        );
      // Expense updates allowed for group members (e.g., editing expense or redistributing splits)
      allow update: if ('groupId' in resource.data) && isGroupMember(resource.data.groupId);
      allow delete: if ('groupId' in resource.data) && isGroupMember(resource.data.groupId) && (
        (('createdBy' in resource.data) && resource.data.createdBy == request.auth.uid) || 
        isGroupAdmin(resource.data.groupId)
      );

      match /comments/{commentId} {
        allow read: if isExpenseGroupMember(expenseId);
        allow create: if isExpenseGroupMember(expenseId) && 
          isCommentAuthor(request.resource.data);
        allow update: if isExpenseGroupMember(expenseId) && 
          isCommentAuthor(resource.data) && 
          isCommentAuthor(request.resource.data);
        allow delete: if isSignedIn() && (
          isCommentAuthor(resource.data) || 
          isExpenseGroupAdmin(expenseId)
        );
      }
    }

    // =========================================================
    // 🤝 SETTLEMENTS (Financial Ledger Protection)
    // =========================================================
    match /settlements/{settlementId} {
      allow read: if isSignedIn() && (
        resource == null || 
        (('groupId' in resource.data) && isGroupMember(resource.data.groupId)) ||
        (('fromUserId' in resource.data) && resource.data.fromUserId == request.auth.uid) ||
        (('toUserId' in resource.data) && resource.data.toUserId == request.auth.uid)
      );
      allow create: if ('groupId' in request.resource.data) && 
        isGroupMember(request.resource.data.groupId) && (
          (('fromUserId' in request.resource.data) && request.resource.data.fromUserId == request.auth.uid) ||
          (('toUserId' in request.resource.data) && request.resource.data.toUserId == request.auth.uid) ||
          (('createdBy' in request.resource.data) && request.resource.data.createdBy == request.auth.uid)
        );
      // Immutable Amounts & Accounts: Only status updates allowed by participants/admins
      allow update: if ('groupId' in resource.data) && 
        isGroupMember(resource.data.groupId) && (
          (('fromUserId' in resource.data) && resource.data.fromUserId == request.auth.uid) || 
          (('toUserId' in resource.data) && resource.data.toUserId == request.auth.uid) || 
          isGroupAdmin(resource.data.groupId)
        ) && request.resource.data.amount == resource.data.amount
          && request.resource.data.fromUserId == resource.data.fromUserId
          && request.resource.data.toUserId == resource.data.toUserId;

      allow delete: if ('groupId' in resource.data) && 
        isGroupMember(resource.data.groupId) && (
          (('createdBy' in resource.data) && resource.data.createdBy == request.auth.uid) || 
          (('fromUserId' in resource.data) && resource.data.fromUserId == request.auth.uid) ||
          (('toUserId' in resource.data) && resource.data.toUserId == request.auth.uid) ||
          isGroupAdmin(resource.data.groupId)
        );
    }

    // =========================================================
    // 📊 ACTIVITIES
    // =========================================================
    match /activities/{activityId} {
      allow read: if isSignedIn() && (
        resource == null || 
        (('groupId' in resource.data) && isGroupMember(resource.data.groupId))
      );
      allow create: if ('groupId' in request.resource.data) && isGroupMember(request.resource.data.groupId);
      allow update, delete: if false; // Audit logs are strictly immutable
    }

    // =========================================================
    // 🔔 NOTIFICATIONS
    // =========================================================
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource == null ||
        (('userId' in resource.data) && resource.data.userId == request.auth.uid) || 
        (('recipientUid' in resource.data) && resource.data.recipientUid == request.auth.uid) ||
        (('groupId' in resource.data) && isGroupMember(resource.data.groupId))
      );
    }

    // =========================================================
    // 🔄 RECURRING EXPENSES
    // =========================================================
    match /recurringExpenses/{id} {
      allow read: if isSignedIn() && (
        resource == null || 
        (('groupId' in resource.data) && isGroupMember(resource.data.groupId))
      );
      allow create: if ('groupId' in request.resource.data) && isGroupMember(request.resource.data.groupId);
      allow update, delete: if isSignedIn() && (
        resource == null || 
        (('groupId' in resource.data) && isGroupMember(resource.data.groupId)) ||
        (request.resource != null && ('groupId' in request.resource.data) && isGroupMember(request.resource.data.groupId))
      );
    }
  }
}
