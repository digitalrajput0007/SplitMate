rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // 🛡️ HELPER FUNCTIONS
    // =========================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getGroupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function groupExists(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId));
    }

    function isGroupMember(groupId) {
      return isSignedIn() && 
        groupExists(groupId) && 
        request.auth.uid in getGroupData(groupId).memberIds;
    }

    function isGroupAdmin(groupId) {
      return isSignedIn() && 
        groupExists(groupId) && 
        (
          getGroupData(groupId).createdBy == request.auth.uid ||
          (('adminIds' in getGroupData(groupId)) && request.auth.uid in getGroupData(groupId).adminIds)
        );
    }

    // =========================================================
    // 👤 USERS & USER CONTACTS
    // =========================================================
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isUser(userId);

      match /contacts/{contactUid} {
        allow read, write: if isUser(userId);
      }
    }

    // =========================================================
    // 👥 GROUPS (Privilege Escalation Protection)
    // =========================================================
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
        request.resource.data.createdBy == request.auth.uid &&
        request.auth.uid in request.resource.data.memberIds;
      
      // Group Admins (createdBy or adminIds) can update anything.
      // Group Members can update metadata, or remove members / leave group.
      // Invited users can accept invitations by adding themselves to memberIds.
      allow update: if isSignedIn() && (
        isGroupAdmin(groupId) ||
        (isGroupMember(groupId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminIds', 'memberIds'])) ||
        (isGroupMember(groupId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminIds']) && !(request.auth.uid in request.resource.data.memberIds)) ||
        (
          request.auth.uid in request.resource.data.memberIds &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminIds']) &&
          request.resource.data.memberIds.hasAll(resource.data.memberIds)
        )
      );

      allow delete: if isGroupAdmin(groupId);

      match /expenses/{expenseId} {
        allow read, create, update, delete: if isGroupMember(groupId);
      }
    }

    // =========================================================
    // 📩 GROUP INVITATIONS
    // =========================================================
    match /groupInvitations/{invitationId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.toUserId == request.auth.uid || 
        resource.data.fromUserId == request.auth.uid ||
        (resource.data.toMobile != null && request.auth.token.phone_number == resource.data.toMobile) ||
        isGroupMember(resource.data.groupId)
      );
      allow create: if isSignedIn() && 
        request.resource.data.fromUserId == request.auth.uid &&
        isGroupMember(request.resource.data.groupId);
      allow update, delete: if isSignedIn() && (
        resource == null ||
        resource.data.toUserId == request.auth.uid || 
        resource.data.fromUserId == request.auth.uid ||
        isGroupMember(resource.data.groupId)
      );
    }

    // =========================================================
    // 💸 EXPENSES & COMMENTS
    // =========================================================
    match /expenses/{expenseId} {
      allow read: if isSignedIn() && (
        resource == null || 
        isGroupMember(resource.data.groupId)
      );
      allow create: if isGroupMember(request.resource.data.groupId) &&
        request.resource.data.createdBy == request.auth.uid;
      // Expense updates allowed for group members (e.g., editing expense or redistributing splits)
      allow update: if isGroupMember(resource.data.groupId);
      allow delete: if isGroupMember(resource.data.groupId) && (
        resource.data.createdBy == request.auth.uid || 
        isGroupAdmin(resource.data.groupId)
      );

      match /comments/{commentId} {
        allow read: if isGroupMember(get(/databases/$(database)/documents/expenses/$(expenseId)).data.groupId);
        allow create: if isGroupMember(get(/databases/$(database)/documents/expenses/$(expenseId)).data.groupId) && 
          request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }

    // =========================================================
    // 🤝 SETTLEMENTS (Financial Ledger Protection)
    // =========================================================
    match /settlements/{settlementId} {
      allow read: if isSignedIn() && (
        resource == null || 
        isGroupMember(resource.data.groupId) ||
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isGroupMember(request.resource.data.groupId) && (
        request.resource.data.fromUserId == request.auth.uid ||
        request.resource.data.toUserId == request.auth.uid ||
        request.resource.data.createdBy == request.auth.uid
      );
      // Immutable Amounts & Accounts: Only status updates allowed by participants/admins
      allow update: if isGroupMember(resource.data.groupId) && (
        resource.data.fromUserId == request.auth.uid || 
        resource.data.toUserId == request.auth.uid || 
        isGroupAdmin(resource.data.groupId)
      ) && request.resource.data.amount == resource.data.amount
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId;

      allow delete: if isGroupMember(resource.data.groupId) && (
        resource.data.createdBy == request.auth.uid || 
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid ||
        isGroupAdmin(resource.data.groupId)
      );
    }

    // =========================================================
    // 📊 ACTIVITIES
    // =========================================================
    match /activities/{activityId} {
      allow read: if isSignedIn() && (resource == null || isGroupMember(resource.data.groupId));
      allow create: if isGroupMember(request.resource.data.groupId);
      allow update, delete: if false; // Audit logs are strictly immutable
    }

    // =========================================================
    // 🔔 NOTIFICATIONS
    // =========================================================
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid || 
        resource.data.recipientUid == request.auth.uid ||
        isGroupMember(resource.data.groupId)
      );
    }

    // =========================================================
    // 🔄 RECURRING EXPENSES
    // =========================================================
    match /recurringExpenses/{id} {
      allow read: if isSignedIn() && (
        resource == null || 
        isGroupMember(resource.data.groupId)
      );
      allow create: if isGroupMember(request.resource.data.groupId);
      allow update, delete: if isSignedIn() && (
        resource == null || 
        isGroupMember(resource.data.groupId) ||
        (request.resource != null && isGroupMember(request.resource.data.groupId))
      );
    }
  }
}
